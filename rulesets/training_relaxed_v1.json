{
  "schemaVersion": 1,
  "id": "training_relaxed_v1",
  "version": "1.0.0",
  "displayName": "Training Relaxed — Game Flow Profile v1",
  "description": "The default teaching evaluators with no minimum, used while a beginner learns turn flow.",
  "disclaimer": "This training profile permits low-value complete hands and always compares them with the standard three-faan profile.",
  "standardComparisonRulesetId": "hk_nyc_social_v1",
  "scoringEvaluatorVersion": "hk-scoring-v1",
  "patternSemantics": {
    "version": "hk_nyc_limits_v1",
    "fourConcealedPungs": { "winMode": "self_draw_only", "concealedKongsCount": false },
    "nineGates": { "waitMode": "pure_nine_sided", "declaredKongsAllowed": false },
    "thirteenOrphans": { "requireThirteenSidedWait": false },
    "coloredDragons": { "requireAllPungsOrKongs": true, "requireMatchingSuitPair": true },
    "heavenlyHand": { "initialBonusReplacementsAllowed": true, "kongBeforeWinAllowed": false },
    "earthlyHand": {
      "trigger": "dealer_first_discard",
      "initialBonusReplacementsAllowed": true,
      "kongBeforeWinAllowed": false
    },
    "limitAggregation": "cap_once_list_all_matches",
    "suppressNonLimitRulesWhenLimitMatches": true
  },
  "tileSet": {
    "bonusTilesEnabled": true,
    "replacementDrawDirection": "back",
    "ordinaryDrawDirection": "front",
    "exhaustionBoundary": "draw_ends_meet"
  },
  "bonusRules": {
    "seatMapping": [
      { "seat": "east", "flower": "flower.plum", "season": "season.spring" },
      { "seat": "south", "flower": "flower.orchid", "season": "season.summer" },
      { "seat": "west", "flower": "flower.chrysanthemum", "season": "season.autumn" },
      { "seat": "north", "flower": "flower.bamboo", "season": "season.winter" }
    ]
  },
  "winRules": {
    "minimumFaan": 0,
    "capFaan": 10,
    "multipleWinners": false,
    "sameTileWinLockUntilNextDraw": false,
    "passedWinLockTriggers": "explicit_pass",
    "passedWinLockIncludesKongRobbery": true,
    "allowSevenPairs": true,
    "sevenPairsAllowsQuadAsTwoPairs": false,
    "specialHandsStackWithSuitPatterns": true,
    "allowThirteenOrphans": true,
    "allowNineGates": true,
    "initialDealWinsEnabled": true
  },
  "claimRules": {
    "equalPriorityResolution": "nearest_after_discarder",
    "multipleWinnerPayment": "settle_each_winner"
  },
  "kongRules": {
    "robAddedKong": true,
    "robConcealedKong": false,
    "concealedKongRobberyForms": [],
    "allowKongImmediatelyAfterChowOrPung": false
  },
  "roundRules": {
    "prevailingWinds": ["east", "south", "west", "north"],
    "dealerRepeatsOnWin": true,
    "dealerRepeatsOnDraw": true,
    "dealerRepeatsWhenAmongMultipleWinners": true
  },
