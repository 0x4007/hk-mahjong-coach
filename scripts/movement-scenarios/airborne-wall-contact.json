{
  "schemaVersion": 2,
  "name": "airborne-wall-contact",
  "description": "Jump into a reachable named wall, hold a brief validated catch, then release to physics before climbing.",
  "seed": "continuous-head-motion/airborne-wall-contact/v2",
  "physics": { "runtime": "rapier" },
  "start": { "position": [0, 0.86, -2], "velocity": [0, 0, 0], "grounded": true, "o2": 100 },
  "staticBoxes": [
    { "obstacleId": "reachable-wall", "center": [0, 2, -4], "halfExtents": [0.7, 2, 0.5] }
  ],
  "frames": [
    { "duration": 0.35, "forward": 1, "sprint": true, "jump": true, "label": "catch" },
    { "duration": 0.04, "jump": true, "zoom": true, "label": "held-contact" },
    { "duration": 0.1, "label": "release-from-contact" },
    { "duration": 0.15, "label": "fall" }
  ],
  "expect": {
    "requiredEvents": [
      { "kind": "wall-contact" },
      { "kind": "traversal-cancel", "traversal": "wall-contact" }
    ],
    "forbiddenEvents": [{ "kind": "wall-climb-request" }],
    "requiredStates": ["wall-contact", "airborne"],
    "finalGrounded": false,
    "finalState": "airborne",
    "ranges": [
      {
        "id": "wall-contact-holds-vertical-position",
        "field": "velocity.y",
        "at": "last",
        "label": "held-contact",
        "equals": 0,
        "tolerance": 0.05
      },
      {
        "id": "wall-contact-is-stabilized",
        "field": "camera.offsets.aimSwayX",
        "at": "max",
        "label": "held-contact",
        "max": 0.001
      },
      {
        "id": "wall-release-resumes-fall",
        "field": "velocity.y",
        "at": "min",
        "label": "fall",
        "max": -1
      }
    ]
  }
}
